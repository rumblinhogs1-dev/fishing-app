rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True when the update ONLY touches the listed fields (no other fields change)
    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── catches ──
    match /catches/{catchId} {
      allow read: if resource.data.visibility == 'public'
                  || (isSignedIn() && resource.data.visibility == 'friends')
                  || isOwner(resource.data.userId);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
                    || (isSignedIn() && onlyUpdating(['commentCount', 'reactionCounts']));
      allow delete: if isOwner(resource.data.userId);
    }

    // ── users ──
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
                    || (isSignedIn() && onlyUpdating(['friendIds', 'friendCount', 'earnedBadges']));
      allow delete: if false;
    }

    // ── comments ──
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // ── reactions ──
    match /reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }

    // ── notifications ──
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.toUserId);
      allow create: if isSignedIn();
      allow update: if isOwner(resource.data.toUserId);
      allow delete: if isOwner(resource.data.toUserId);
    }

    // ── friendRequests ──
    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
                  && (resource.data.fromUserId == request.auth.uid
                      || resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.toUserId == request.auth.uid;
      allow delete: if isSignedIn()
                    && (resource.data.fromUserId == request.auth.uid
                        || resource.data.toUserId == request.auth.uid);
    }

    // ── trips ──
    match /trips/{tripId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.auth.uid in request.resource.data.memberIds;
      allow update: if isSignedIn()
                    && (resource.data.userId == request.auth.uid
                        || request.auth.uid in resource.data.memberIds);
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ── groups ──
    match /groups/{groupId} {
      allow read: if isSignedIn()
                  && (request.auth.uid in resource.data.memberIds
                      || request.auth.uid in resource.data.adminIds);
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.memberIds
                    && request.auth.uid in request.resource.data.adminIds;
      allow update: if isSignedIn()
                    && (request.auth.uid in resource.data.adminIds
                        || (request.auth.uid in resource.data.memberIds
                            && onlyUpdating(['lastMessage', 'lastMessageAt'])));
      allow delete: if isSignedIn()
                    && request.auth.uid in resource.data.adminIds;
    }

    // ── messages ──
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && onlyUpdating(['imageUrl']);
      allow delete: if false;
    }

    // ── challenges ──
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
                    && resource.data.createdBy == request.auth.uid;
    }

    // ── depthPoints ──
    match /depthPoints/{pointId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // ── spots ──
    match /spots/{spotId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
