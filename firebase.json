{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": [
    {
      "site": "fishing-app-46485",
      "public": "firebase-dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/utah-stocking",
          "function": "utahStocking"
        },
        {
          "source": "/api/idaho-stocking",
          "function": "idahoStocking"
        },
        {
          "source": "/api/oregon-stocking",
          "function": "oregonStocking"
        },
        {
          "source": "/api/virginia-stocking",
          "function": "virginiaStocking"
        },
        {
          "source": "/api/montana-stocking",
          "function": "montanaStocking"
        },
        {
          "source": "/api/michigan-stocking",
          "function": "michiganStocking"
        },
        {
          "source": "/api/wisconsin-stocking",
          "function": "wisconsinStocking"
        },
        {
          "source": "/api/nc-stocking",
          "function": "ncStocking"
        },
        {
          "source": "/api/tennessee-stocking",
          "function": "tennesseeStocking"
        },
        {
          "source": "/api/california-stocking",
          "function": "californiaStocking"
        },
        {
          "source": "/api/wv-stocking",
          "function": "wvStocking"
        },
        {
          "source": "/api/maryland-stocking",
          "function": "marylandStocking"
        },
        {
          "source": "/api/sc-stocking",
          "function": "scStocking"
        },
        {
          "source": "/api/iowa-stocking",
          "function": "iowaStocking"
        },
        {
          "source": "/api/gemini",
          "function": "geminiProxy"
        },
        {
          "source": "/api/places",
          "function": "placesProxy"
        },
        {
          "source": "/api/subscribe",
          "function": "subscribeEmail"
        },
        {
          "source": "/fishing-app/**",
          "destination": "/fishing-app/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleapis.com https://*.firebasestorage.app https://*.tile.openstreetmap.org https://upload.wikimedia.org; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://*.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.open-meteo.com https://waterservices.usgs.gov https://photon.komoot.io https://nominatim.openstreetmap.org https://*.sentry.io https://*.google-analytics.com wss://*.firebaseio.com; frame-src https://accounts.google.com https://*.firebaseapp.com; object-src 'none'; base-uri 'self'"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin-allow-popups"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=63072000; includeSubDomains; preload"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(self)"
            },
            {
              "key": "X-XSS-Protection",
              "value": "1; mode=block"
            }
          ]
        }
      ]
    },
    {
      "site": "mycatchbook-redirect",
      "public": "firebase-dist/redirect",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "regex": "/(.*)",
          "destination": "https://catchdaddy.net/:1",
          "type": 301
        }
      ]
    }
  ]
}
