{
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "firebase-dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/fishing-app/**",
        "destination": "/fishing-app/index.html"
      },
      {
        "source": "**",
        "destination": "/fishing-app/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/fishing-app/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ]
  }
}
